#!/bin/bash
# 写完一章后运行此脚本自动检查所有原则违规
# 用法: bash check.sh 8-正文-第XX章.txt

F="$1"
echo "========== 检查: $F =========="
echo ""

echo "1. 破折号(——):"
grep -n '——' "$F" || echo "   无"
echo ""

echo "2. 问号缺失(吗/什么/怎么/谁/哪。):"
grep -n '[吗什么怎么谁哪]。' "$F" | grep -v '本章完' || echo "   无"
echo ""

echo "3. 不是X是Y(所有变体 含是Y不是X/不是因为):"
grep -n '不是[^。]\{1,30\}，是\|不是[^。]\{1,30\}。是\|，是[^。]\{1,30\}不是\|。是[^。]\{1,30\}不是\|不是因为[^。]*，是因为' "$F" || echo "   无"
echo "   ^人工复核上面一行"
echo ""

echo "4. 句末碎词(。很轻。|。很慢。|。很重。|。冰的。|。冷的。):"
grep -n '。很轻。\|。很慢。\|。很重。\|。冰的。\|。冷的。\|。热的。' "$F" || echo "   无"
echo ""

echo "5. 独词成段感官标签(。X的。):"
grep -n '^。\{1,3\}的。$' "$F" 2>/dev/null || echo "   无"
echo ""

echo "6. 高频描写(尾音往):"
grep -n '尾音往' "$F" || echo "   无"
echo ""

echo "7. POV滑移(主角):"
grep -n '主角' "$F" || echo "   无"
echo ""

echo "8. 大段(超过5句连续以。结尾):"
awk 'BEGIN{c=0} /。/ {c++} /^$/ {if(c>5) print "   "NR-1": "c"句连续"; c=0} END{}' "$F"
echo ""

echo "9. 正文内章节编号引用(Ch+数字):"
grep -n 'Ch[0-9]' "$F" || echo "   无"
echo ""

echo "10. 鲜明时间指引(第一天/第二天/第三天):"
grep -n '第[一二三四五六七八九]天\|第一天\|第二天\|第三天\|第四天' "$F" || echo "   无"
echo ""

echo "11. 字数估算:"
python3 -c "
import re
with open('$F','r',encoding='utf-8') as fh:
    text=fh.read()
cn=len(re.findall(r'[一-鿿]',text))
print(f'   纯汉字: {cn}字')
" 2>/dev/null || echo "   (python3不可用)"
echo ""

echo "========== 检查完成 =========="
